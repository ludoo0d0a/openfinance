{
  "name": "openfinance",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Browse, search and replay PSD2 / Open Finance / SIC / Wero flows and ISO 20022 messages.",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "dev:api": "wrangler pages dev dist --ip 127.0.0.1 --port 8788",
    "dev:full": "concurrently -k -n vite,api -c cyan,magenta \"npm run dev\" \"npm run dev:api\"",
    "start": "npm run build && npm run dev:full",
    "start:ui": "npm run dev",
    "build": "tsc -b && vite build && tsx scripts/prerender.mts",
    "prerender": "tsx scripts/prerender.mts",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "serve": "npm run build && wrangler pages dev dist --ip 127.0.0.1 --port 8788",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "@types/cytoscape": "^3.21.9",
    "cytoscape": "^3.34.1",
    "fast-xml-parser": "^4.5.0",
    "lucide-react": "^1.31.0",
    "minisearch": "^7.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250523.0",
    "@eslint/js": "^9.27.0",
    "@tailwindcss/vite": "^4.1.7",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^10.0.4",
    "eslint": "^9.27.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.1.0",
    "tailwindcss": "^4.1.7",
    "tsx": "4.23.12",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.3.5",
    "vitest": "^3.1.4",
    "wrangler": "^4.16.0"
  }
}
